<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Search & Filter Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meetings"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <!-- Search Row (No Shadow/Elevation) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="#757575"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Cari meeting..."
                    android:background="@null"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:fontFamily="sans-serif"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:autofillHints="no" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSemua"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Semua"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_color"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="12dp"
                    app:chipStartPadding="12dp"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHariIni"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hari Ini"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_color"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="12dp"
                    app:chipStartPadding="12dp"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAkanDatang"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akan Datang"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_color"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="12dp"
                    app:chipStartPadding="12dp"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBerlangsung"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berlangsung"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_color"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="12dp"
                    app:chipStartPadding="12dp"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSelesai"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selesai"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_color"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="12dp"
                    app:chipStartPadding="12dp"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDibatalkan"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dibatalkan"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_color"
                    app:chipCornerRadius="20dp"
                    app:chipEndPadding="12dp"
                    app:chipStartPadding="12dp"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible"
                android:padding="40dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_calendar_empty"
                    android:contentDescription="@null"
                    android:layout_marginBottom="24dp"
                    android:alpha="0.6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum ada meeting"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buat meeting pertamamu untuk mulai\nmengelola jadwal rapat dan ringkasan AI."
                    android:textSize="14sp"
                    android:textColor="#9E9E9E"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="28dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBuatMeetingEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/rounded_button"
                    android:text="+ Buat Meeting"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="28dp"
                    android:stateListAnimator="@null"
                    android:elevation="2dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMeetings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="88dp"
                android:paddingHorizontal="20dp" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMeeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:layout_marginBottom="80dp"
        android:src="@drawable/ic_add"
        app:backgroundTint="#FF9800"
        app:tint="@android:color/white"
        app:fabSize="normal"
        app:elevation="6dp"
        app:hoveredFocusedTranslationZ="10dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
