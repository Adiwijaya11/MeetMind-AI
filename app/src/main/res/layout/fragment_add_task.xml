<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Judul Tugas"
            android:textColor="#757575"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="#333333"
            android:hint="Masukkan judul tugas" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Deadline (DD/MM/YYYY)"
            android:textColor="#757575"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTaskDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="#333333"
            android:focusable="false"
            android:clickable="true"
            android:hint="Pilih tanggal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="PIC (Penanggung Jawab)"
            android:textColor="#757575"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTaskPic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="#333333"
            android:hint="Masukkan nama PIC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Sumber Rapat"
            android:textColor="#757575"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMeetingSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="#333333"
            android:hint="Sumber rapat" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Prioritas"
            android:textColor="#757575"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <AutoCompleteTextView
            android:id="@+id/actvPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="#333333"
            android:inputType="none"
            android:hint="Pilih prioritas" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Status"
            android:textColor="#757575"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <AutoCompleteTextView
            android:id="@+id/actvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/rounded_edittext"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="#333333"
            android:inputType="none"
            android:hint="Pilih status" />

        <Button
            android:id="@+id/btnSaveTask"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Simpan Tugas"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>